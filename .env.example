# star-pass environment configuration template.
#
# Copy this file to `.env` and fill in the required values:
#
#     cp .env.example .env
#
# The two API credentials are always required.  A run carries its own
# calendar search window, given to `runs collect` on the command line,
# so there is nothing to set here for it.  Every other value is an
# optional override;
# when unset, the defaults in app/star_pass/_defaults.py apply, so the
# tool works out of the box for Rose City Rollers.  Other organizations
# can override the deployment values below without editing any code.

# --- Required: API credentials ---
# Amplify (Galaxy Digital) API bearer token.
AMPLIFY_TOKEN=your-amplify-api-token
# Google Calendar API key.
GCAL_TOKEN=your-google-calendar-api-key

# --- Optional: time zone ---
# The league's IANA time zone. Everything that has to agree with a
# wall clock reads this: which calendar day a Slack summary covers,
# its "as of" stamp, and the calendar search window. Do not rely on
# the host clock, which is UTC in a container or CI runner, where a
# Portland evening is already the next day.
# LOCAL_TIMEZONE=America/Los_Angeles
# Time zone for the calendar search window alone. Defaults to
# LOCAL_TIMEZONE; set it only if the calendar differs from the league.
# GCAL_TIMEZONE=America/Los_Angeles

# --- Optional: Slack integration ---
# Slack bot token (starts with xoxb-); required only for Slack features.
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# Destination channel ID for live Slack posts.
# SLACK_CHANNEL_ID=C0123ABC456
# Private dev/test channel ID used for all Slack testing.
# SLACK_DEV_CHANNEL_ID=C0123ABC456
# How many calendar days a sign-up summary covers, counting today as day
# one: 1 is today only, 2 adds tomorrow. Shifts that already started are
# never included. Override per run with -d/--days.
# SLACK_SUMMARY_DAYS=1
# Days from today to the first day a summary covers: 0 starts today, 1
# starts tomorrow. A notice posted ahead of the shifts it covers uses
# this to leave out the day it is sent, so a Friday post about the
# weekend lists Saturday and Sunday only. Override with -D.
# SLACK_SUMMARY_START_IN_DAYS=0
# Comma-separated Amplify need IDs to summarize when -N is not supplied.
# This is what lets a scheduled run work with no arguments.
# SLACK_SUMMARY_NEED_IDS=607934,628861
# Slack style for the sign-up buttons. 'primary' fills them, which
# reads as a control rather than a label on a phone. Slack also
# accepts 'danger'; leave it empty for outlined buttons.
# SLACK_SIGN_UP_BUTTON_STYLE=primary
# Text appended to a sign-up button's label, marking that it opens a
# browser. Avoid an emoji shortcode such as :arrow_upper_right:, which
# Slack renders as a full emoji tile with a hover card that crowds out
# the label. The default arrow ends with an invisible variation
# selector (U+FE0E) asking for the text glyph; copying the value by
# hand can drop it and bring the tile back. Set it empty for none.
# SLACK_SIGN_UP_BUTTON_SUFFIX=" ↗︎"
# Call to action shown above the sign-up buttons.
# SLACK_SIGN_UP_PROMPT=Sign up if you plan to attend and haven't already. Thanks!
# Emoji flanking the summary heading, as Slack shortcodes. Empty by default.
# SLACK_SUMMARY_EMOJI=:flamingo::zebra_face:
# Separator between the event name and the role in an opportunity title.
# Opportunities sharing the text before it are grouped together, and the
# text after it becomes the role label, so "Adult Scrimmages: Skating
# Officials" contributes a "Skating Officials" line to an "Adult
# Scrimmages" row. A title without the separator keeps its full text as
# the row heading and reports a bare count.
# SLACK_TITLE_SEPARATOR=": "

# --- Optional: API endpoints ---
# BASE_AMPLIFY_URL=https://api.galaxydigital.com/api
# BASE_GCAL_URL=https://www.googleapis.com/calendar/v3/calendars

# --- Optional: HTTP behavior ---
# Request timeout in whole seconds.
# HTTP_TIMEOUT=10
# Total retry attempts for transient failures (idempotent methods).
# HTTP_RETRY_TOTAL=3
# Exponential backoff factor between retries, in seconds.
# HTTP_RETRY_BACKOFF_FACTOR=0.5

# --- Optional: Amplify sign-up (response) reads ---
# Timeout in whole seconds for one page of responses.
# AMPLIFY_RESPONSES_TIMEOUT=90
# How far back to read sign-ups, in days. The Amplify API cannot filter
# responses by need or by shift date, so a run reads the domain's recent
# responses and filters them locally; this bounds that read. A sign-up
# cannot predate its shift, so 90 days covers upcoming shifts with room
# to spare. Raise it if sign-ups may be created further ahead.
# AMPLIFY_RESPONSES_SINCE_DAYS=90
# Results per page (the API maximum is 150).
# AMPLIFY_RESPONSES_PER_PAGE=150
# Safety cap on pages read in one run.
# AMPLIFY_RESPONSES_MAX_PAGES=80
# Warn when the oldest counted sign-up is within this many days of the
# look-back cutoff (a thin margin risks undercounting).
# AMPLIFY_RESPONSES_MARGIN_WARN_DAYS=7

# --- Required for the API service: authentication ---
# The token every request to the API service is authenticated against.
# Not needed to run the command line client, which calls the core
# directly. Generate one rather than typing it, and keep it at least 32
# characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# STAR_PASS_API_TOKEN=

# --- Required for the front end: session signing ---
# What the front end signs a browser session with, and derives that
# session's CSRF token from. Only the front-end container needs it.
# Generate one rather than typing it, and keep it at least 32
# characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# STAR_PASS_SESSION_SECRET=

# --- Optional: Front end ---
# Where the front end reaches the API service. The default is the
# service name on the internal network, which is what Compose gives it.
# STAR_PASS_API_URL=http://api:8000
# How long a session lasts without being used. Twelve hours by
# default; there is no remember-me.
# STAR_PASS_SESSION_MAX_AGE_SECONDS=43200
# Whether the session cookies say Secure. Leave this alone in a
# deployment: turn it off only for local development over plain HTTP,
# where a browser would otherwise refuse to store them.
# STAR_PASS_COOKIES_SECURE=true
# How long the front end waits for the API on a request that is not a
# stream. The slow ones read Amplify.
# STAR_PASS_BFF_TIMEOUT_SECONDS=120
# Where the page served at the root is read from. The image ships one
# at /web; point this at a mounted directory to serve a built
# interface without rebuilding. The service refuses to start if there
# is no index.html there.
# STAR_PASS_WEB_ROOT=/web

# --- Optional: the deployment in front of both services ---
# Read by 'compose.yaml' and the Caddyfile, not by the application.
# The name star-pass is served at. The default is served with Caddy's
# internal certificate authority, which is what local development and
# a tailnet both want (D14).
# STAR_PASS_SITE_ADDRESS=localhost
# How that name gets its certificate. 'internal' uses Caddy's own
# authority. An email address instead switches to Let's Encrypt, which
# needs the name to be publicly resolvable with 80 and 443 reachable —
# a deliberate step, because D14 decided against putting this on the
# public internet.
# STAR_PASS_TLS=internal

# --- Optional: Jobs ---
# How many jobs the API service runs at once. One by default: the tool
# does one operation at a time, and a job asked for while another runs
# waits its turn rather than failing.
# STAR_PASS_JOB_WORKERS=1

# --- Optional: Job event stream ---
# How often the stream looks for what a job has reported since it last
# looked, and how long it stays silent before sending a comment to keep
# the connection open.
# STAR_PASS_JOB_EVENT_POLL_SECONDS=0.5
# STAR_PASS_JOB_EVENT_HEARTBEAT_SECONDS=15

# --- Optional: Credential test ---
# How often one caller may test the Amplify credential, and over how
# long. Every attempt spends a request on Amplify, and a person
# clicking Test in Settings needs a handful in a minute.
# STAR_PASS_CREDENTIAL_TEST_ATTEMPTS=5
# STAR_PASS_CREDENTIAL_TEST_WINDOW_SECONDS=60

# --- Optional: Database ---
# Where the SQLite database holding runs, revisions, events and the
# change log is kept. Point this at a mounted volume in a deployment so
# the state outlives the container.
# STAR_PASS_DATABASE_PATH=data/star_pass.db
# Seconds a statement waits for another connection to release its lock.
# STAR_PASS_DATABASE_BUSY_TIMEOUT=5

# --- Optional: Logging ---
# Minimum log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# LOG_LEVEL=INFO

# --- Optional: Shift matching ---
# Minimum fuzzy-match confidence (0-100) required to assign a category
# when no alias appears literally in an event title. Titles below this
# are sent to review.
# FUZZY_MATCH_THRESHOLD=80

# --- Optional: Google Calendar IDs (organization specific) ---
# GCAL_EVENTS_CAL_ID=your-events-calendar-id@resource.calendar.google.com
# GCAL_PRACTICES_CAL_ID=your-practices-calendar-id@resource.calendar.google.com

# --- Optional: Google Calendar query strings (comma-separated) ---
# GCAL_EVENTS_QUERY_STRINGS=
# GCAL_PRACTICES_QUERY_STRINGS=officials,scrimmage
